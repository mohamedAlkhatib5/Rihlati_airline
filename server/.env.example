APP_NAME="Rihlati Airlines API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dubai
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rihlati
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_STORE=file

# Signing key for access tokens.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# Never commit the real value.
JWT_SECRET=
JWT_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14

# Front-end origin allowed to call the API (CORS).
FRONTEND_URL=http://localhost:5173

# `log` writes emails to storage/logs instead of sending them, which is what
# you want in development. Switch to smtp with real credentials for staging.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@rihlati.demo"
MAIL_FROM_NAME="${APP_NAME}"
